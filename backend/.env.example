# ===== 声音克隆 · 有声读物工坊 配置 =====
# 复制为 .env 后按需修改

# GPT-SoVITS 本地服务（可选，声音克隆首选）
# GPT_SOVITS_URL=http://127.0.0.1:9880
# GPT_SOVITS_REF_DIR=E:/GPT-SoVITS/refs   # 本机路径，需与 GPT-SoVITS 运行在同一台机器

# 云 API 密钥（也可在网页「设置」页填写，优先用数据库里的值）
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# FISH_API_KEY=

# LLM 文稿润色（OpenAI 兼容，默认 DeepSeek，性价比最高）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
